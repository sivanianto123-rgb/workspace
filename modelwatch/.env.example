# Copy to .env and adjust. All values have sane defaults; nothing here is required
# for local SQLite development.

# Flask
FLASK_CONFIG=development          # development | production | testing
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
HOST=127.0.0.1
PORT=5000

# Database ---------------------------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file at data/modelwatch.db.
# For PostgreSQL:
# DATABASE_URL=postgresql://modelwatch:modelwatch@localhost:5432/modelwatch
# (a legacy "postgres://" scheme is rewritten to "postgresql://" automatically)

# Drift-detection tuning -----------------------------------------------------
PSI_STABLE_MAX=0.1               # PSI < this  -> "stable"
PSI_MODERATE_MAX=0.2            # PSI < this  -> "moderate", else "significant"
KS_P_VALUE_THRESHOLD=0.05       # KS p-value below this flags drift
DRIFT_WINDOW_SIZE=300           # most-recent predictions compared to baseline
RETRAIN_DRIFT_FRACTION=0.30     # retrain if >30% of features drift significantly

# Training -------------------------------------------------------------------
TEST_SIZE=0.2
RANDOM_STATE=42
# MODELS_DIR=./models
